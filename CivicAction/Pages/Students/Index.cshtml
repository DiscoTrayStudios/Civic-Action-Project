@page
@model CivicAction.Pages.Students.IndexModel

@{
    ViewData["Title"] = "Index";
}

@if (User.Identity?.IsAuthenticated == true)
{
    <h1 style = "margin-top: 30px; margin-bottom: 20px" >Welcome, @Model.CurrentUser?.FirstMidName!</h1>
}

<table class="table">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.Student[0].FirstMidName)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Student[0].LastName)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Student[0].Grade)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Student[0].School)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Student[0].IsAdmin)
            </th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model.Student) {
        <tr>
            <td>
                @Html.DisplayFor(modelItem => item.FirstMidName)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.LastName)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Grade)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.School)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.IsAdmin)
            </td>
        </tr>
}
    </tbody>
</table>
