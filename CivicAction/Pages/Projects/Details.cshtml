@page
@model CivicAction.Pages.Projects.DetailsModel

@{
    ViewData["Title"] = "Details";
}

<h1>Details: @Html.DisplayFor(model => model.Project.Title)</h1>

<div>
    <hr />
    <dl class="row">
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.Project.Title)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.Project.Title)
        </dd>
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.Project.Description)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.Project.Description)
        </dd>      
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.Project.Organization)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.Project.Organization)
        </dd>
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.Project.SiteLocation)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.Project.SiteLocation)
        </dd>
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.Project.Start)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.Project.Start)
        </dd>
        @if (!string.IsNullOrEmpty(Model.Project.FilePath))
        {
            <dt class="col-sm-2">Project Image</dt>
            <dd class="col-sm-10">
                <img src="@Model.Project.FilePath"
                    alt="Project image"
                    style="max-width: 400px; height: auto;" />
            </dd>
        }
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.Project.Status)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.Project.Status)
        </dd>
    </dl>
</div>
<table class="table">
    <thead>
        <tr>
            <th>
                Student
            </th>
            <th>
                Hours
            </th>
        </tr>
    </thead>
    <tbody>
    @foreach (var item in Model.Project.Inclusions)
    {
        <tr>
            <td>
                @item.Student.FirstMidName @item.Student.LastName
            </td>
            <td>
                @item.Hours
            </td>
        </tr>
    }
    </tbody>
</table>
@foreach (var item in Model.Updates)
{
    <div>
        <hr />
        <dl class="row">
            <dt class="col-sm-2">
                Title
            </dt>
            <dd class="col-sm-10">
                @item.Title
            </dd>
            <dt class="col-sm-2">
                Student
            </dt>
            <dd class="col-sm-10">
                @item.Student.FirstMidName @item.Student.LastName
            </dd>
            <dt class="col-sm-2">
                Hours
            </dt>
            <dd class="col-sm-10">
                @item.Hours
            </dd>
            <dt class="col-sm-2">
                Feedback
            </dt>
            <dd class="col-sm-10">
                @item.Feedback
            </dd>
        </dl>
    </div>
}
<div>
    <a asp-page="./Edit" asp-route-id="@Model.Project.Id">Edit</a> |
    <a asp-page="./Index">Back to List</a>
</div>
